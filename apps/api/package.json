{
  "name": "@gbe/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Gbè : comptes invités, synchronisation du journal d'événements, suppression du compte",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@gbe/domain": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
