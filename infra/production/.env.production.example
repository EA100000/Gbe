# Copie en .env.production sur le serveur et remplis. Ne jamais commiter .env.production.
# Noms de domaine pointant vers l'adresse IP du serveur (enregistrements DNS de type A).
API_DOMAIN=api.exemple.bj
PACKS_DOMAIN=packs.exemple.bj

# Secrets : longues valeurs aléatoires, par exemple : openssl rand -base64 48 | tr -d '/+='
POSTGRES_PASSWORD=a-remplacer
JWT_SECRET=a-remplacer-par-au-moins-32-caracteres

# Contact affiché sur /confidentialite et /suppression-du-compte.
CONTACT_EMAIL=
