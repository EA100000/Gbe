{
  "name": "gbe",
  "private": true,
  "description": "Gbè — application d'apprentissage du fongbè (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "tsx scripts/validate-content.ts",
    "native:check": "tsx scripts/check-native-modules.ts",
    "audio:placeholders": "tsx scripts/make-placeholder-audio.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:validate && npm run native:check",
    "content:build": "tsx scripts/build-packs.ts",
    "content:workbook": "tsx scripts/content-workbook.ts",
    "content:import": "tsx scripts/import-unit.ts",
    "demo:web": "tsx scripts/build-web-demo.ts",
    "packs:publish": "tsx scripts/publish-packs.ts",
    "packs:upload": "tsx --env-file-if-exists=.env scripts/upload-packs.ts",
    "packs:serve": "tsx scripts/serve-packs.ts",
    "web:export": "cd apps/mobile && npx expo export --platform web --output-dir dist",
    "e2e:web": "npm run web:export && playwright test -c e2e/playwright.config.ts",
    "api:dev": "npm run dev --workspace apps/api",
    "api:build": "npm run build --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "read-excel-file": "9.3.10",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "write-excel-file": "4.1.1"
  },
  "overrides": {
    "react-native-svg": "15.15.4"
  }
}
