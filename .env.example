# Copie ce fichier en .env et remplace les valeurs. Le fichier .env ne doit jamais être commité.

# --- Base PostgreSQL (docker compose) ---
POSTGRES_DB=gbe
POSTGRES_USER=gbe
# Lettres et chiffres seulement : ce mot de passe est aussi placé dans une URL.
POSTGRES_PASSWORD=a-remplacer

# --- Stockage compatible S3 (docker compose) ---
MINIO_ROOT_USER=gbe
MINIO_ROOT_PASSWORD=a-remplacer-par-8-caracteres-minimum

# --- Publication des packs (npm run packs:upload) ---
# En local : le MinIO de docker compose (seau gbe-packs créé automatiquement).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gbe-packs
S3_ACCESS_KEY_ID=gbe
S3_SECRET_ACCESS_KEY=a-remplacer-par-8-caracteres-minimum

# --- API (apps/api) ---
# Pour `npm run dev -w apps/api` hors Docker : la base exposée sur le port 5432.
DATABASE_URL=postgresql://gbe:a-remplacer@localhost:5432/gbe
# Au moins 32 caractères aléatoires, par exemple : openssl rand -base64 48
JWT_SECRET=a-remplacer
PORT=3000
# Origines web autorisées, séparées par des virgules (vide = aucune).
CORS_ORIGINS=
# Créations de compte et demandes de jeton permises par minute et par adresse IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
RUN_MIGRATIONS=true
# Contact affiché sur les pages /confidentialite et /suppression-du-compte (fiche Google Play).
CONTACT_EMAIL=
# Un compte sans connexion depuis ce nombre de jours est supprimé avec son journal.
INACTIVE_ACCOUNT_DAYS=365

# Tests de l'API : une base jetable, vidée à chaque test (jamais la base de développement).
TEST_DATABASE_URL=postgresql://gbe:a-remplacer@localhost:5432/gbe_test

# --- Appli mobile ---
# Cette variable se met dans apps/mobile/.env (c'est là qu'Expo la lit), pas dans ce fichier.
# Adresse de l'API, fixée au build. Vide = synchronisation désactivée (appli 100 % hors-ligne).
# Avec Expo Go sur un téléphone : l'adresse IP du poste, pas localhost (ex. http://192.168.1.20:3000).
# EXPO_PUBLIC_API_URL=
# Adresse du catalogue des packs (dossier qui contient catalog.json). Vide = pack embarqué seulement.
# En local : http://<IP-du-poste>:9000/gbe-packs (MinIO) ou http://<IP-du-poste>:8090 (npm run packs:serve).
# EXPO_PUBLIC_PACKS_URL=
# Page de confidentialité ouverte depuis le Profil (vide = ligne masquée), par exemple
# https://<adresse-de-l-api>/confidentialite
# EXPO_PUBLIC_PRIVACY_URL=
# Adresse qui reçoit « Signaler un problème » du Profil (vide = ligne masquée). Lisible dans l'appli.
# EXPO_PUBLIC_CONTACT_EMAIL=
