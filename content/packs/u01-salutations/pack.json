      {
        "id": "u01-histoire",
        "kind": "story",
        "title": "Au marché Dantokpa",
        "exercises": [
          {
            "id": "u01-histoire-e01",
            "type": "story",
            "title": "Acheter du poisson",
            "setting": "Dantokpa",
            "lines": [
              {
                "speaker": "vendor",
                "fon": "Kwabɔ ! A fɔn à ?",
                "fr": "Bienvenue ! Bien réveillé·e ?",
                "audio": "story-1"
              },
              {
                "speaker": "learner",
                "fon": "Ɛɛn ! Bì nyí nabí ?",
                "fr": "Oui ! Combien ça coûte ?",
                "audio": "story-2"
              },
              {
                "speaker": "vendor",
                "audio": "story-3",
                "audioOnly": true,
                "hintFr": "Écoute d’abord : quel prix annonce-t-elle ?"
              },
              {
                "speaker": "learner",
                "fon": "E v’axi dín !",
                "fr": "C’est trop cher !",
                "audio": "story-4"
              }
            ],
            "question": {
              "promptFr": "Que réponds-tu pour négocier ?",
              "successFr": "Bien négocié !",
              "choices": [
                {
                  "fon": "A wà nǔ",
                  "correct": false,
                  "explanation": [
                    { "fon": "A wà nǔ" },
                    { "fr": ", c’est « merci » : garde-le pour la fin de l’échange." }
                  ]
                },
                {
                  "fon": "Sà nú mì ganji",
                  "correct": true,
                  "explanation": [
                    { "fon": "Sà nú mì ganji" },
                    { "fr": " : littéralement « vends-moi bien »." }
                  ]
                },
                {
                  "fon": "Bo yi bo wá",
                  "correct": false,
                  "explanation": [
                    { "fon": "Bo yi bo wá" },
                    { "fr": ", c’est « au revoir » : pas encore, la négociation continue !" }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
